# Private Key for deployment (NEVER commit your actual private key!)
# Export from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here

# RPC URLs - Get these from Alchemy, Infura, or QuickNode
# Alchemy: https://www.alchemy.com/ (Recommended)
# Infura: https://www.infura.io/
# QuickNode: https://www.quicknode.com/

# Ethereum Mainnet RPC
ETHEREUM_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY

# Sepolia Testnet RPC (Recommended for testing)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY

# Goerli Testnet RPC (Being deprecated)
GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/YOUR-API-KEY

# Etherscan API Key for contract verification
# Get it from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Contract Configuration (used by scripts)
NFT_CONTRACT_ADDRESS=deployed_contract_address_here
RECIPIENT_ADDRESS=recipient_wallet_address_here
TOKEN_URI=ipfs://your_metadata_hash_here
